{
  "name": "rag-test",
  "version": "1.0.0",
  "description": "RAG Vector Search MCP Server",
  "main": "mcp-server.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "build-db": "node scripts/build_vector_db.js",
    "build-db-ts": "tsx scripts/build_vector_db.ts",
    "mcp-server": "node mcp-server.js",
    "mcp-server-ts": "tsx mcp-server.ts",
    "query-db-ts": "tsx scripts/query_vector_db.ts",
    "metadata-init": "tsx scripts/manage_metadata.ts init",
    "metadata-list": "tsx scripts/manage_metadata.ts list",
    "metadata-setup": "mysql -u $DB_USER -p$DB_PASSWORD $DB_NAME < sql/create_metadata_tables.sql && mysql -u $DB_USER -p$DB_PASSWORD $DB_NAME < sql/insert_sample_metadata.sql",
    "metadata-test": "tsx scripts/test_metadata_integration.ts",
    "compile": "tsc",
    "dev": "ts-node --watch",
    "clean": "rm -rf dist",
    "lint": "echo 'No linting configured yet'",
    "test": "echo 'No tests configured yet'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/community": "^0.3.19",
    "@langchain/core": "^0.3.26",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@qdrant/js-client-rest": "^1.14.1",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "langchain": "^0.3.8",
    "mysql2": "^3.11.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
