# RAG Vector Search Docker Environment Configuration
# 이 파일을 복사하여 .env로 사용하세요: cp .env.docker .env

# ============================================
# MySQL Database Configuration (외부 연결)
# ============================================
DB_HOST=host.docker.internal
# DB_HOST=192.168.1.100  # 또는 실제 MySQL 서버 IP
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name

# ============================================
# Qdrant Vector Database (내부 - 수정 불필요)
# ============================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
COLLECTION_NAME=schema_documents

# ============================================
# HuggingFace Embedding Model
# ============================================
HF_MODEL=jhgan/ko-sroberta-multitask
EMBEDDING_DIMENSION=768

# ============================================
# Text Chunking Configuration
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# MCP Server Configuration
# ============================================
MCP_TIMEOUT=30000

# ============================================
# Node.js Environment
# ============================================
NODE_ENV=production

# ============================================
# 사용 예시:
# ============================================
# 1. 이 파일을 .env로 복사
# 2. MySQL 정보를 실제 값으로 수정
# 3. docker-compose up -d 실행
# 4. docker-compose exec rag-service npm run build-db 실행 (벡터 DB 구축)
# 5. MCP 서버 사용 또는 테스트